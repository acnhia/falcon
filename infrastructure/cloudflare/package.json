{
  "name": "cloudflare-infrastructure",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Provisioning and deployment tooling for the Cloudflare target. Holds no application code; the runtime it deploys lives in backend/edge-worker.",
  "scripts": {
    "provision:r2": "node scripts/provision-r2.mjs",
    "provision:d1": "node scripts/provision-d1.mjs",
    "provision:onboarding-d1": "node scripts/provision-onboarding-d1.mjs",
    "provision:auth": "node scripts/provision-auth-secrets.mjs",
    "provision:turnstile": "node scripts/provision-turnstile.mjs",
    "launch": "node scripts/launch.mjs",
    "launch:docker": "node scripts/docker-launch.mjs"
  }
}
