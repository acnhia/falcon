# Template for `infra/cloudflare/.dev.vars`, which is deliberately NOT tracked in git
# (it is Wrangler's conventional file for real local secrets - see .gitignore).
#
# Copy this file to `.dev.vars` before running `npm test` or `wrangler dev`; the Worker
# test suite reads it via vitest-pool-workers and the login-gate tests fail without it.
# The deployed Worker never uses these - it gets its own values pushed as Worker secrets
# by scripts/provision-auth-secrets.mjs and scripts/provision-turnstile.mjs.
#
# Every value below is intentionally fake: admin/admin is the demo credential, and the
# Turnstile keys are Cloudflare's publicly-documented "always passes" test pair, which
# keeps the tests offline and deterministic instead of calling the real siteverify API.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
SESSION_SECRET=test-only-session-secret-do-not-use-in-production
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
