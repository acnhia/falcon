# Template for `.dev.vars`, which is deliberately not tracked in git - it is Wrangler's
# conventional file for real local secrets (see .gitignore).
#
# This is needed only for `npm run dev` (a local Wrangler server). The test suite does NOT
# read it: vitest.config.ts declares its bindings explicitly, so `npm test` passes on a fresh
# clone with no setup. The deployed Worker gets its own values as Worker secrets, pushed by
# infrastructure/cloudflare/scripts/provision-auth-secrets.mjs and provision-turnstile.mjs.
#
# Every value below is fake. admin/admin is the demo credential, and the Turnstile pair is
# Cloudflare's publicly documented "always passes" test key.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
SESSION_SECRET=test-only-session-secret-do-not-use-in-production
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
